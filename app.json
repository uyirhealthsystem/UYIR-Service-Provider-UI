{
  "expo": {
    "name": "Service Provider Uyir",
    "slug": "service-provider",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "serviceprovider",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.uyir.serviceprovider",
      "icon": "./assets/expo.icon",
      "config": {
        "googleMapsApiKey": "AIzaSyDAuQ2AcAut4_AFpYSD3CjYE0vURQk4Uwk"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.uyir.serviceprovider",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDLj2eyb6i-Z_eDgLyFiNNujRN-G-ipCus"
        }
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
