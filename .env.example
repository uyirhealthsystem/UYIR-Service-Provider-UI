# Copy to .env.local and fill in real values. Never commit .env.local.
EXPO_PUBLIC_HBC_API_URL=
EXPO_PUBLIC_GATEWAY_SHARED_SECRET=
GOOGLE_MAPS_IOS_API_KEY=
GOOGLE_MAPS_ANDROID_API_KEY=

# ── Calling the backend through the API gateway ──────────────────────────────
# Leave empty to call each service directly (built-in defaults). To go through
# the gateway, set every *_API_URL to the gateway and the two prefixes below.
# EXPO_PUBLIC_AUTH_API_URL=http://<gateway>:8080/api/v1
# EXPO_PUBLIC_HOSPITAL_API_URL=http://<gateway>:8080
# EXPO_PUBLIC_AMBULANCE_API_URL=http://<gateway>:8080
# EXPO_PUBLIC_ECG_API_URL=http://<gateway>:8080
# EXPO_PUBLIC_HBC_API_URL=http://<gateway>:8080
# EXPO_PUBLIC_LAB_API_URL=http://<gateway>:8080
# EXPO_PUBLIC_LAB_SCAN_API_URL=http://<gateway>:8080
# EXPO_PUBLIC_LAB_REGISTRATION_API_URL=http://<gateway>:8080
# EXPO_PUBLIC_HEALTH_PARTNER_API_URL=http://<gateway>:8080
# EXPO_PUBLIC_HEALTH_PARTNER_API_PREFIX=/api/v1/hp
# EXPO_PUBLIC_PRO_API_URL=http://<gateway>:8080
# EXPO_PUBLIC_PRO_API_PREFIX=/api/v1/pro
# Through the gateway EXPO_PUBLIC_GATEWAY_SHARED_SECRET must stay EMPTY - anything
# EXPO_PUBLIC_* is readable by anyone who has the app.
